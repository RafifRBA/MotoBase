NODE_ENV=development
# port selain FE
PORT=6318

# Connection string MongoDB Atlas.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/motobase

# Origin frontend yang diizinkan (Next.js default: 3000)
CORS_ORIGIN=http://localhost:3000

# Minimal 32 karakter. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-secret-minimum-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-minimum-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
LOW_STOCK_DEFAULT=5
TRACKING_TOKEN_TTL_DAYS=90

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# notifikasi
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
